{
  "name": "@mp-lb/zog-docs",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "fumadocs-mdx source.config.ts .source && tsc --project tsconfig.json && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "fumadocs-mdx source.config.ts .source && tsc --project tsconfig.json --noEmit",
    "test": "fumadocs-mdx source.config.ts .source && vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "fumadocs-core": "latest",
    "fumadocs-mdx": "latest",
    "fumadocs-ui": "^16.8.12",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/mdx": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
