{
  "name": "@mp-lb/zog",
  "version": "0.1.0",
  "description": "A tiny Zod-first persistence layer for MongoDB.",
  "packageManager": "pnpm@10.10.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "SPEC.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mongodb",
    "zod",
    "repository"
  ],
  "license": "MIT",
  "peerDependencies": {
    "mongodb": "^6.0.0",
    "zod": "^3.22.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "mongodb": "^6.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "^4.1.0"
  }
}
